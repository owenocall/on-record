# Copy to .env.local and fill in. Never commit real values.

# Website (Vercel) - public, read-only; RLS limits anon to published notes
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Scanner (GitHub secrets) - never expose to the website
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Contact email for the SEC User-Agent header
SEC_CONTACT_EMAIL=
